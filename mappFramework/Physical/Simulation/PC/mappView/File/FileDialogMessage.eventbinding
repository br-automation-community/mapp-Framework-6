<?xml version="1.0" encoding="utf-8"?>
<EventBindingSet id="FileDialogMessage" xmlns="http://www.br-automation.com/iat2014/eventbinding/v2" xmlns:types="http://www.br-automation.com/iat2015/widgetTypes/v2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Bindings>
    <EventBinding id="ContentLoaded.FileDialog_Message">
      <Source xsi:type="clientSystem.Event" event="ContentLoaded" />
      <Operand datatype="ANY_INT" name="MsgType">
        <ReadTarget xsi:type="opcUa.NodeAction.Read" refId="::FileMgr:MpFileManagerUIConnect.MessageBox.Type">
          <Method xsi:type="opcUa.NodeAction.GetValue" />
        </ReadTarget>
      </Operand>
      <Operand datatype="ANY_INT" name="ErrorNumber">
        <ReadTarget xsi:type="opcUa.NodeAction.Read" refId="::FileMgr:MpFileManagerUIConnect.MessageBox.ErrorNumber">
          <Method xsi:type="opcUa.NodeAction.GetValue" />
        </ReadTarget>
      </Operand>
      <EventHandler condition="MsgType = 1">
        <Action>
          <Target xsi:type="widgets.brease.TextOutput.Action" contentRefId="FileDialogMessage" widgetRefId="TextOutFileMessage">
            <Method xsi:type="widgets.brease.TextOutput.Action.SetValue" value="$IAT/mappFramework/File/ConfirmDelete" />
          </Target>
        </Action>
      </EventHandler>
      <EventHandler condition="MsgType = 2">
        <Action>
          <Target xsi:type="widgets.brease.TextOutput.Action" contentRefId="FileDialogMessage" widgetRefId="TextOutFileMessage">
            <Method xsi:type="widgets.brease.TextOutput.Action.SetValue" value="$IAT/mappFramework/File/ConfirmDelete" />
          </Target>
        </Action>
      </EventHandler>
      <EventHandler condition="MsgType = 3">
        <Action>
          <Target xsi:type="widgets.brease.TextOutput.Action" contentRefId="FileDialogMessage" widgetRefId="TextOutFileMessage">
            <Method xsi:type="widgets.brease.TextOutput.Action.SetValue" value="$IAT/mappFramework/File/ConfirmDelete" />
          </Target>
        </Action>
      </EventHandler>
      <EventHandler condition="(MsgType = 4 OR MsgType = 5) AND ErrorNumber = 8193">
        <Action>
          <Target xsi:type="widgets.brease.TextOutput.Action" contentRefId="FileDialogMessage" widgetRefId="TextOutFileMessage">
            <Method xsi:type="widgets.brease.TextOutput.Action.SetValue" value="$IAT/mappFramework/File/Status.CommandNotAllowed" />
          </Target>
        </Action>
      </EventHandler>
      <EventHandler condition="(MsgType = 4 OR MsgType = 5) AND ErrorNumber = 8194">
        <Action>
          <Target xsi:type="widgets.brease.TextOutput.Action" contentRefId="FileDialogMessage" widgetRefId="TextOutFileMessage">
            <Method xsi:type="widgets.brease.TextOutput.Action.SetValue" value="$IAT/mappFramework/File/Status.NoElementToPaste" />
          </Target>
        </Action>
      </EventHandler>
      <EventHandler condition="(MsgType = 4 OR MsgType = 5) AND ErrorNumber = 8195">
        <Action>
          <Target xsi:type="widgets.brease.TextOutput.Action" contentRefId="FileDialogMessage" widgetRefId="TextOutFileMessage">
            <Method xsi:type="widgets.brease.TextOutput.Action.SetValue" value="$IAT/mappFramework/File/Status.NothingSelected" />
          </Target>
        </Action>
      </EventHandler>
      <EventHandler condition="(MsgType = 4 OR MsgType = 5) AND ErrorNumber = 8196">
        <Action>
          <Target xsi:type="widgets.brease.TextOutput.Action" contentRefId="FileDialogMessage" widgetRefId="TextOutFileMessage">
            <Method xsi:type="widgets.brease.TextOutput.Action.SetValue" value="$IAT/mappFramework/File/Status.FolderAlreadyExists" />
          </Target>
        </Action>
      </EventHandler>
      <EventHandler condition="(MsgType = 4 OR MsgType = 5) AND ErrorNumber = 8197">
        <Action>
          <Target xsi:type="widgets.brease.TextOutput.Action" contentRefId="FileDialogMessage" widgetRefId="TextOutFileMessage">
            <Method xsi:type="widgets.brease.TextOutput.Action.SetValue" value="$IAT/mappFramework/File/Status.InvalidFileDevice" />
          </Target>
        </Action>
      </EventHandler>
      <EventHandler condition="(MsgType = 4 OR MsgType = 5) AND ErrorNumber = 8198">
        <Action>
          <Target xsi:type="widgets.brease.TextOutput.Action" contentRefId="FileDialogMessage" widgetRefId="TextOutFileMessage">
            <Method xsi:type="widgets.brease.TextOutput.Action.SetValue" value="$IAT/mappFramework/File/Status.NewNameNotEntered" />
          </Target>
        </Action>
      </EventHandler>
      <EventHandler condition="(MsgType = 4 OR MsgType = 5) AND ErrorNumber = 8199">
        <Action>
          <Target xsi:type="widgets.brease.TextOutput.Action" contentRefId="FileDialogMessage" widgetRefId="TextOutFileMessage">
            <Method xsi:type="widgets.brease.TextOutput.Action.SetValue" value="$IAT/mappFramework/File/Status.InvalidName" />
          </Target>
        </Action>
      </EventHandler>
      <EventHandler condition="(MsgType = 4 OR MsgType = 5) AND ErrorNumber = 8200">
        <Action>
          <Target xsi:type="widgets.brease.TextOutput.Action" contentRefId="FileDialogMessage" widgetRefId="TextOutFileMessage">
            <Method xsi:type="widgets.brease.TextOutput.Action.SetValue" value="$IAT/mappFramework/File/Status.PasteNotAllowed" />
          </Target>
        </Action>
      </EventHandler>
      <EventHandler condition="(MsgType = 4 OR MsgType = 5) AND ErrorNumber = 8201">
        <Action>
          <Target xsi:type="widgets.brease.TextOutput.Action" contentRefId="FileDialogMessage" widgetRefId="TextOutFileMessage">
            <Method xsi:type="widgets.brease.TextOutput.Action.SetValue" value="$IAT/mappFramework/File/Status.GeneralError" />
          </Target>
        </Action>
      </EventHandler>
    </EventBinding>
    <EventBinding id="MpFileManagerUIConnect.MessageBox.Type.ValueChange.1">
      <Source xsi:type="opcUa.Event" refId="::FileMgr:MpFileManagerUIConnect.MessageBox.Type" event="ValueChanged" />
      <EventHandler condition="newValue = 0 AND oldValue &gt; 0">
        <Action>
          <Target xsi:type="clientSystem.Action">
            <Method xsi:type="clientSystem.Action.CloseDialog" dialogId="FileMessage" />
          </Target>
        </Action>
      </EventHandler>
    </EventBinding>
  </Bindings>
</EventBindingSet>